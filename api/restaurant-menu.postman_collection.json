{
  "info": {
    "_postman_id": "e81a3d1c-3e3d-4bea-bdca-f8da07ba8ec1",
    "name": "Restaurant Menu Manager QA",
    "description": "Local-only API checks for the Restaurant Menu Manager portfolio project.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4567" },
    { "key": "createdItemId", "value": "1" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/health" },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Status is 200', () => pm.response.to.have.status(200));",
          "pm.test('Health status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
        ] }
      }]
    },
    {
      "name": "List menu items",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/menu" },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Status is 200', () => pm.response.to.have.status(200));",
          "pm.test('Response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
        ] }
      }]
    },
    {
      "name": "Create valid dish",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Mushroom risotto\",\n  \"price\": 12.50,\n  \"category\": \"MAIN_DISH\",\n  \"isVegetarian\": true\n}" },
        "url": "{{baseUrl}}/api/menu/dish"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Status is 201', () => pm.response.to.have.status(201));",
          "const body = pm.response.json();",
          "pm.test('Generated ID is returned', () => pm.expect(body.id).to.be.a('number'));",
          "pm.collectionVariables.set('createdItemId', body.id);"
        ] }
      }]
    },
    {
      "name": "Reject invalid price",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Invalid item\",\n  \"price\": 0,\n  \"category\": \"DESSERT\",\n  \"isVegetarian\": false\n}" },
        "url": "{{baseUrl}}/api/menu/dish"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Status is 400', () => pm.response.to.have.status(400));",
          "pm.test('Safe error is returned', () => pm.expect(pm.response.json().error).to.be.a('string'));"
        ] }
      }]
    },
    {
      "name": "Delete created item",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/menu/{{createdItemId}}" },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Status is 204', () => pm.response.to.have.status(204));"
        ] }
      }]
    },
    {
      "name": "Delete missing item",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/menu/999999" },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Status is 404', () => pm.response.to.have.status(404));"
        ] }
      }]
    }
  ]
}
